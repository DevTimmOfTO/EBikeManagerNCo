  "fixed_sql": [
    {
      "name": "bikes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bikes\" (\"id\" TEXT NOT NULL, \"nickname\" TEXT NOT NULL, \"manufacturer\" TEXT NULL, \"model\" TEXT NULL, \"colour\" TEXT NULL, \"purchase_date\" INTEGER NULL, \"adfc_code\" TEXT NULL, \"adfc_code_photo_path\" TEXT NULL, \"frame_size\" TEXT NULL, \"wheel_size\" TEXT NULL, \"motor_type\" TEXT NULL, \"motor_wattage\" INTEGER NULL, \"battery_capacity_wh\" INTEGER NULL, \"battery_purchase_date\" INTEGER NULL, \"purchase_price_cents\" INTEGER NULL, \"photo_path\" TEXT NULL, \"notes\" TEXT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "battery_history_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"battery_history_entries\" (\"id\" TEXT NOT NULL, \"bike_id\" TEXT NOT NULL REFERENCES bikes (id) ON DELETE CASCADE, \"timestamp\" INTEGER NOT NULL, \"event_type\" TEXT NOT NULL, \"state_of_charge_start\" INTEGER NULL, \"state_of_charge_end\" INTEGER NULL, \"estimated_cycle_count\" INTEGER NULL, \"estimated_health_pct\" REAL NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "trips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trips\" (\"id\" TEXT NOT NULL, \"bike_id\" TEXT NULL REFERENCES bikes (id) ON DELETE CASCADE, \"start_time\" INTEGER NOT NULL, \"end_time\" INTEGER NULL, \"distance_meters\" REAL NULL, \"duration_seconds\" INTEGER NULL, \"avg_speed_kmh\" REAL NULL, \"elevation_gain_meters\" REAL NULL, \"calories_kcal\" REAL NULL, \"active_minutes\" INTEGER NULL, \"heart_rate_avg_bpm\" INTEGER NULL, \"health_connect_record_id\" TEXT NULL UNIQUE, \"source\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "trip_points",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_points\" (\"id\" TEXT NOT NULL, \"trip_id\" TEXT NOT NULL REFERENCES trips (id) ON DELETE CASCADE, \"sequence_index\" INTEGER NOT NULL, \"lat\" REAL NOT NULL, \"lng\" REAL NOT NULL, \"elevation_meters\" REAL NULL, \"timestamp\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "parking_locations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"parking_locations\" (\"id\" TEXT NOT NULL, \"bike_id\" TEXT NOT NULL REFERENCES bikes (id) ON DELETE CASCADE, \"lat\" REAL NOT NULL, \"lng\" REAL NOT NULL, \"timestamp\" INTEGER NOT NULL, \"note\" TEXT NULL, \"photo_path\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"display_name\" TEXT NULL, \"avatar_path\" TEXT NULL, \"unit_system\" TEXT NOT NULL DEFAULT 'metric', \"theme_preference\" TEXT NOT NULL DEFAULT 'system', \"default_bike_id\" TEXT NULL REFERENCES bikes (id) ON DELETE SET NULL, \"health_sync_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"health_sync_enabled\" IN (0, 1)), \"show_bicycle_shops_layer\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_bicycle_shops_layer\" IN (0, 1)), \"show_repair_stations_layer\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_repair_stations_layer\" IN (0, 1)), \"show_charging_stations_layer\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_charging_stations_layer\" IN (0, 1)), \"show_cycleways_layer\" INTEGER NOT NULL DEFAULT 1 CHECK (\"show_cycleways_layer\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL);"
        }
      ]
